      "py": {
        "raised": true,
        "error_type": "ValidationError",
        "message": "family='nb' with estimated dispersion requires method='REML' (profiling the GCV/UBRE score over theta collapses to theta~0); use method='REML' or fix the dispersion via NegativeBinomial(theta=...)"
