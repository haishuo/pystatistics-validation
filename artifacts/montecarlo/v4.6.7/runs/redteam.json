{
  "schema": "validation-run/v1",
  "env": {
    "pystatistics_version": "4.6.7",
    "install_source": "pypi",
    "python": "3.13.13",
    "numpy": "2.4.6",
    "os": "macOS-26.5.1-arm64-arm-64bit-Mach-O",
    "cpu": "arm",
    "device": "cpu",
    "torch": "2.12.1",
    "available_devices": [
      "mps",
      "cpu"
    ],
    "r_packages": {
      "boot": "1.3.32",
      "stats": "4.5.2"
    }
  },
  "config": {
    "suite": "montecarlo-redteam",
    "reference": "R boot / exact enumeration; fail-loud probes",
    "tolerance_contract": "hard cases match R on shared resamples or exact enumeration; fidelity = no silent substitution (G2), documented conventions (two-sided |.|, BCa acceleration)"
  },
  "records": [
    {
      "key": "hard_cases",
      "checks": [
        {
          "group": "hard",
          "case": "small_n=6",
          "statistic": "corr",
          "t_stat_max_abs": 8.881784197001252e-16,
          "pass": true
        },
        {
          "group": "hard",
          "case": "skew_perc_vs_bca",
          "statistic": "ratio",
          "perc": [
            1.2439816392604583,
            2.0961696900148583
          ],
          "bca": [
            1.2404027792847836,
            2.0813343313807207
          ],
          "endpoint_separation": 0.018414218609812405,
          "rel_to_width": 0.021608163354920558,
          "note": "percentile != BCa here (skewed ratio) \u2014 BCa shifts the interval; pystatistics computes both, perc matches R. law/corr (tight tier) shows a much larger shift.",
          "pass": true
        },
        {
          "group": "hard",
          "case": "boundary_corr~1",
          "statistic": "corr",
          "t0": 0.9999994295046447,
          "perc_ci": [
            0.9999985010353158,
            0.9999998189525635
          ],
          "no_crash": true,
          "upper_within_1": true,
          "pass": true
        },
        {
          "group": "hard",
          "case": "perm_ties",
          "alternative": "two-sided",
          "p_py": 0.07931920680793192,
          "p_exact": 0.0793650793650794,
          "abs_diff": 4.5872557147483284e-05,
          "pass": true
        },
        {
          "group": "hard",
          "case": "degenerate_bca_all_equal",
          "t0": 3.5,
          "se": 0.0,
          "bca_ci": [
            3.5,
            3.5
          ],
          "behavior": "returns degenerate [t0, t0] interval (a=0 fallback, se=0); no crash, no garbage \u2014 documented",
          "raised": false,
          "pass": true
        }
      ]
    },
    {
      "key": "fidelity",
      "checks": [
        {
          "group": "fidelity",
          "case": "default_invocation",
          "boot_R": 999,
          "boot_backend": "cpu_bootstrap",
          "perm_R": 9999,
          "perm_backend": "cpu_permutation",
          "p_value_finite": true,
          "pass": true
        },
        {
          "group": "fidelity",
          "case": "two_sided_convention",
          "mean_diff": {
            "py": 0.3970460295397046,
            "exact_abs": 0.3968253968253968,
            "exact_tail": 0.3968253968253968,
            "py_matches_abs": true
          },
          "ratio_noncentered": {
            "py": 0.8903610963890362,
            "exact_abs": 0.8888888888888888,
            "exact_tail": 0.3968253968253968,
            "py_matches_abs": true,
            "abs_vs_tail_gap": 0.49206349206349204
          },
          "note": "permutation_test two-sided uses |perm|>=|obs|; correct & matches exact for a null-centered statistic (mean-diff). For a non-centered statistic (ratio ~1) the |.| convention diverges from the proper 2*min-tail two-sided \u2014 a documented footgun: pass a null-centered statistic (a difference), not a ratio.",
          "pass": true
        },
        {
          "group": "fidelity",
          "case": "gpu_optin_fail_loud",
          "gpu_missing_flag_raises": true,
          "gpu_declared_but_median_raises": true,
          "gpu_balanced_raises": true,
          "perm_gpu_missing_flag_raises": true,
          "cpu_default_backend": "cpu_bootstrap",
          "pass": true
        }
      ]
    }
  ]
}